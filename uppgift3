import numpy as np
import matplotlib.pyplot as plt
def odefun(t, U, b, vR, vL):
    theta = U [2]

    dx = ((vR(t) + vL(t))/2)*np.cos(theta)
    dy = ((vR(t) + vL(t))/2)*np.sin(theta)
    dtheta = (vR(t)- vL(t))/b

    return np.array([dx, dy, dtheta])

