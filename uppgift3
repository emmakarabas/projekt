def forward_euler(f, t0, tf, U0, N):
    h = (tf - t0)/N
    
    U = np.zeros((3, N+1))
    t = np.zeros((N+1))

    t[0] = t0
    U[:, 0] = U0
    
    for j in range(N):
        U[:, j+1] = U[:, j] +h*f(t[j], U[:, j])
        t[j+1] = t[j] + h
    
    return t, U

